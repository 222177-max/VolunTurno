
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex min-h-dvh items-center justify-center bg-slate-50 px-4 py-5">
    <div class="w-full max-w-md">

      <!-- LOGOTIPO -->
      <header class="mb-5 text-center">
        <h1 class="text-2xl font-bold text-emerald-800">
          🌱 VolunTurno
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Seguridad de tu cuenta
        </p>
      </header>

      <!-- ESTADO DE CARGA -->
      <p
        id="verificando"
        role="status"
        class="text-center text-sm text-slate-500"
      >
        Verificando sesión...
      </p>

      <!-- TARJETA -->
      <section
        id="panel-cambio"
        class="hidden rounded-xl border border-slate-200
               bg-white p-5 shadow-sm"
      >
        <h2 class="text-xl font-bold text-slate-900">
          Cambiar contraseña
        </h2>

        <p class="mt-2 text-sm text-slate-600">
          Por seguridad, reemplaza tu contraseña temporal
          antes de continuar.
        </p>

        <form id="form-cambio" class="mt-5 space-y-4">

          <!-- CONTRASEÑA ACTUAL -->
          <div>
            <label
              for="actual"
              class="mb-1.5 block text-sm font-medium text-slate-800"
            >
              Contraseña actual
            </label>

            <div class="relative">
              <input
                id="actual"
                type="password"
                autocomplete="current-password"
                required
                placeholder="Ingresa tu contraseña temporal"
                class="w-full rounded-lg border border-slate-300
                       py-2.5 pl-3 pr-11 text-sm outline-none
                       focus:border-emerald-600 focus:ring-2
                       focus:ring-emerald-100"
              />

              <button
                type="button"
                data-target="actual"
                class="toggle-password absolute inset-y-0 right-3
                       flex items-center text-slate-500
                       hover:text-emerald-700"
                aria-label="Mostrar contraseña actual"
                aria-pressed="false"
              >
                <svg class="ojo-abierto h-5 w-5" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <svg class="ojo-cerrado hidden h-5 w-5" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M3 3l18 18M10.6 5.1A11 11 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.1 3.7"/>
                  <path d="M6.1 6.1C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.4-.9"/>
                  <path d="M10 10a3 3 0 0 0 4 4"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- CONTRASEÑA NUEVA -->
          <div>
            <label
              for="nueva"
              class="mb-1.5 block text-sm font-medium text-slate-800"
            >
              Nueva contraseña
            </label>

            <div class="relative">
              <input
                id="nueva"
                type="password"
                autocomplete="new-password"
                required
                placeholder="Crea una contraseña segura"
                class="w-full rounded-lg border border-slate-300
                       py-2.5 pl-3 pr-11 text-sm outline-none
                       focus:border-emerald-600 focus:ring-2
                       focus:ring-emerald-100"
              />

              <button
                type="button"
                data-target="nueva"
                class="toggle-password absolute inset-y-0 right-3
                       flex items-center text-slate-500
                       hover:text-emerald-700"
                aria-label="Mostrar nueva contraseña"
                aria-pressed="false"
              >
                <svg class="ojo-abierto h-5 w-5" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <svg class="ojo-cerrado hidden h-5 w-5" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M3 3l18 18M10.6 5.1A11 11 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.1 3.7"/>
                  <path d="M6.1 6.1C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.4-.9"/>
                  <path d="M10 10a3 3 0 0 0 4 4"/>
                </svg>
              </button>
            </div>

            <!-- REQUISITOS EN TIEMPO REAL -->
            <div
              class="mt-3 rounded-lg bg-slate-50 p-3"
              aria-label="Requisitos de contraseña"
            >
              <p class="mb-2 text-xs font-semibold text-slate-700">
                La contraseña debe contener:
              </p>

              <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
                <p id="regla-longitud" class="text-xs text-slate-500">
                  ○ Mínimo 12 caracteres
                </p>
                <p id="regla-mayuscula" class="text-xs text-slate-500">
                  ○ Una mayúscula
                </p>
                <p id="regla-minuscula" class="text-xs text-slate-500">
                  ○ Una minúscula
                </p>
                <p id="regla-numero" class="text-xs text-slate-500">
                  ○ Un número
                </p>
                <p id="regla-especial" class="text-xs text-slate-500">
                  ○ Un carácter especial
                </p>
                <p id="regla-tamano" class="text-xs text-slate-500">
                  ○ Máximo 72 bytes
                </p>
              </div>
            </div>
          </div>

          <!-- CONFIRMAR CONTRASEÑA -->
          <div>
            <label
              for="confirmar"
              class="mb-1.5 block text-sm font-medium text-slate-800"
            >
              Confirmar nueva contraseña
            </label>

            <div class="relative">
              <input
                id="confirmar"
                type="password"
                autocomplete="new-password"
                required
                placeholder="Repite la nueva contraseña"
                class="w-full rounded-lg border border-slate-300
                       py-2.5 pl-3 pr-11 text-sm outline-none
                       focus:border-emerald-600 focus:ring-2
                       focus:ring-emerald-100"
              />

              <button
                type="button"
                data-target="confirmar"
                class="toggle-password absolute inset-y-0 right-3
                       flex items-center text-slate-500
                       hover:text-emerald-700"
                aria-label="Mostrar confirmación"
                aria-pressed="false"
              >
                <svg class="ojo-abierto h-5 w-5" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <svg class="ojo-cerrado hidden h-5 w-5" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M3 3l18 18M10.6 5.1A11 11 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.1 3.7"/>
                  <path d="M6.1 6.1C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.4-.9"/>
                  <path d="M10 10a3 3 0 0 0 4 4"/>
                </svg>
              </button>
            </div>

            <p id="coincidencia" class="mt-1.5 text-xs text-slate-500"
               aria-live="polite"></p>
          </div>

          <!-- MENSAJES -->
          <p
            id="mensaje-cambio"
            role="alert"
            class="hidden rounded-lg p-3 text-sm"
          ></p>

          <!-- BOTÓN GUARDAR -->
          <button
            id="guardar-clave"
            type="submit"
            class="w-full rounded-lg bg-emerald-700 px-4 py-3
                   text-sm font-semibold text-white
                   transition hover:bg-emerald-800
                   active:scale-[0.98]
                   disabled:cursor-wait disabled:opacity-60"
          >
            Guardar nueva contraseña
          </button>

        </form>
      </section>

    </div>
  </main>
</Layout>

<script>
  const panel = document.querySelector<HTMLElement>('#panel-cambio');
  const verificando = document.querySelector<HTMLElement>('#verificando');
  const form = document.querySelector<HTMLFormElement>('#form-cambio');
  const boton = document.querySelector<HTMLButtonElement>('#guardar-clave');
  const mensaje = document.querySelector<HTMLElement>('#mensaje-cambio');

  const actual = document.querySelector<HTMLInputElement>('#actual');
  const nueva = document.querySelector<HTMLInputElement>('#nueva');
  const confirmar = document.querySelector<HTMLInputElement>('#confirmar');
  const coincidencia = document.querySelector<HTMLElement>('#coincidencia');

  // 1. MOSTRAR U OCULTAR CONTRASEÑAS
  document.querySelectorAll<HTMLButtonElement>('.toggle-password')
    .forEach((control) => {
      control.addEventListener('click', () => {
        const destino = control.dataset.target;
        if (!destino) return;

        const campo = document.getElementById(destino) as HTMLInputElement;
        if (!campo) return;

        const mostrar = campo.type === 'password';
        campo.type = mostrar ? 'text' : 'password';

        control.querySelector('.ojo-abierto')
          ?.classList.toggle('hidden', mostrar);

        control.querySelector('.ojo-cerrado')
          ?.classList.toggle('hidden', !mostrar);

        control.setAttribute('aria-pressed', String(mostrar));
        control.setAttribute(
          'aria-label',
          `${mostrar ? 'Ocultar' : 'Mostrar'} ${destino === 'actual'
            ? 'contraseña actual'
            : destino === 'nueva'
              ? 'nueva contraseña'
              : 'confirmación'}`
        );
      });
    });

  // 2. VALIDACIONES
  function obtenerReglas(clave: string) {
    return [
      {
        id: 'longitud',
        texto: 'Mínimo 12 caracteres',
        cumple: clave.length >= 12
      },
      {
        id: 'mayuscula',
        texto: 'Una mayúscula',
        cumple: /\p{Lu}/u.test(clave)
      },
      {
        id: 'minuscula',
        texto: 'Una minúscula',
        cumple: /\p{Ll}/u.test(clave)
      },
      {
        id: 'numero',
        texto: 'Un número',
        cumple: /[0-9]/.test(clave)
      },
      {
        id: 'especial',
        texto: 'Un carácter especial',
        cumple: /[^\p{L}\p{N}\s]/u.test(clave)
      },
      {
        id: 'tamano',
        texto: 'Máximo 72 bytes',
        cumple: clave.length > 0 &&
          new TextEncoder().encode(clave).length <= 72
      }
    ];
  }

  function actualizarValidaciones() {
    const clave = nueva?.value ?? '';

    for (const regla of obtenerReglas(clave)) {
      const elemento = document.getElementById(`regla-${regla.id}`);
      if (!elemento) continue;

      elemento.textContent =
        `${regla.cumple ? '✓' : '○'} ${regla.texto}`;

      elemento.className = regla.cumple
        ? 'text-xs font-medium text-emerald-700'
        : 'text-xs text-slate-500';
    }

    if (!coincidencia || !confirmar) return;

    if (!confirmar.value) {
      coincidencia.textContent = '';
    } else if (confirmar.value === clave) {
      coincidencia.textContent = '✓ Las contraseñas coinciden';
      coincidencia.className = 'mt-1.5 text-xs text-emerald-700';
    } else {
      coincidencia.textContent = '✕ Las contraseñas no coinciden';
      coincidencia.className = 'mt-1.5 text-xs text-red-600';
    }
  }

  nueva?.addEventListener('input', actualizarValidaciones);
  confirmar?.addEventListener('input', actualizarValidaciones);

  // 3. MOSTRAR MENSAJES
  function mostrarMensaje(texto: string, error = true) {
    if (!mensaje) return;

    mensaje.textContent = texto;
    mensaje.className = error
      ? 'rounded-lg bg-red-50 p-3 text-sm text-red-700'
      : 'rounded-lg bg-emerald-50 p-3 text-sm text-emerald-700';
  }

  // 4. VERIFICAR SESIÓN
  async function comprobarSesion() {
    try {
      const respuesta = await fetch(
        'http://localhost:3006/api/auth/me',
        { credentials: 'include' }
      );

      if (respuesta.status === 401) {
        window.location.replace('/login');
        return;
      }

      if (!respuesta.ok) {
        throw new Error('No se pudo verificar la sesión.');
      }

      const datos = await respuesta.json();

      if (!datos.usuario.requiereCambio) {
        window.location.replace(
          datos.usuario.rol === 'coordinador'
            ? '/dashboard'
            : '/portal'
        );
        return;
      }

      verificando?.classList.add('hidden');
      panel?.classList.remove('hidden');

    } catch {
      if (verificando) {
        verificando.textContent =
          'No se pudo conectar al servidor. Comprueba el backend.';
      }
    }
  }

  comprobarSesion();

  // 5. GUARDAR LA CONTRASEÑA NUEVA
  form?.addEventListener('submit', async (evento) => {
    evento.preventDefault();

    if (!form.reportValidity() || !boton || !mensaje) return;

    const passwordActual = actual?.value ?? '';
    const passwordNueva = nueva?.value ?? '';
    const confirmacion = confirmar?.value ?? '';

    const reglas = obtenerReglas(passwordNueva);

    if (!reglas.every((regla) => regla.cumple)) {
      mostrarMensaje(
        'La nueva contraseña todavía no cumple todos los requisitos.'
      );
      return;
    }

    if (passwordNueva !== confirmacion) {
      mostrarMensaje('Las contraseñas nuevas no coinciden.');
      return;
    }

    if (passwordNueva === passwordActual) {
      mostrarMensaje(
        'La nueva contraseña debe ser diferente a la actual.'
      );
      return;
    }

    boton.disabled = true;
    boton.textContent = 'Guardando contraseña...';
    mensaje.classList.add('hidden');

    try {
      const respuesta = await fetch(
        'http://localhost:3006/api/auth/cambiar-password',
        {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            passwordActual,
            passwordNueva
          })
        }
      );

      const resultado = await respuesta.json();

      if (!respuesta.ok) {
        throw new Error(
          resultado.mensaje || 'No se pudo actualizar la contraseña.'
        );
      }

      mostrarMensaje('Contraseña actualizada correctamente.', false);

      // Volver al Login: el backend cierra la sesión
      window.location.replace('/login?cambio=ok');

    } catch (error) {
      mostrarMensaje(
        error instanceof Error
          ? error.message
          : 'Ocurrió un error inesperado.'
      );
    } finally {
      boton.disabled = false;
      boton.textContent = 'Guardar nueva contraseña';
    }
  });
</script>
