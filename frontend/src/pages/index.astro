
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header class="bg-emerald-700 px-8 py-5 text-white">
    <h1 class="text-2xl font-bold">VolunTurno</h1>
    <p class="text-sm">Gestión de turnos y voluntarios</p>
  </header>

  <main class="mx-auto max-w-4xl px-6 py-16">
    <section class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
      <span class="text-sm font-semibold text-emerald-700">
        Proyecto de Interacción Humano–Computador
      </span>

      <h2 class="mt-4 text-3xl font-bold">
        Bienvenido a VolunTurno
      </h2>

      <p class="mt-4 text-slate-600">
        Organiza voluntarios, equipos y turnos de manera sencilla.
      </p>

      <!-- Enlace a la pantalla de Login -->
      <a
        href="/login"
        class="mt-8 inline-flex items-center justify-center gap-2
               rounded-lg bg-emerald-700 px-6 py-3 font-medium
               text-white transition-all duration-150
               hover:bg-emerald-800 hover:shadow-md
               active:scale-[0.98] active:bg-emerald-900
               focus-visible:outline-none
               focus-visible:ring-2 focus-visible:ring-emerald-500
               focus-visible:ring-offset-2"
      >
        Comenzar
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</Layout>
