
---
import Layout from '../layouts/Layout.astro';
import AppShell from '../components/AppShell.astro';
---

<Layout>
  <AppShell
    titulo="Panel principal"
    descripcion="Resumen de actividad y tareas prioritarias."
    pagina="dashboard"
  >

    <!-- INDICADORES PRINCIPALES -->
    <section
      aria-label="Indicadores generales"
      class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"
    >
      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          Turnos próximos
        </h2>
        <p id="total-turnos" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-emerald-700 dark:text-emerald-400">
          Próximas actividades
        </p>
      </article>

      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          Cupos por cubrir
        </h2>
        <p id="total-cupos" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-amber-700 dark:text-amber-400">
          Pendientes de asignación
        </p>
      </article>

      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          Personas activas
        </h2>
        <p id="total-personas" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-emerald-700 dark:text-emerald-400">
          Equipo registrado
        </p>
      </article>

      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          Asistencias pendientes
        </h2>
        <p id="total-asistencias" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          Por verificar
        </p>
      </article>
    </section>

    <!-- ESTADOS DE INTERFAZ -->
    <section class="mt-5" aria-label="Estados de interfaz">
      <div class="flex flex-wrap items-center gap-3">
        <label for="estado-demo" class="text-sm font-medium">
          Vista de estados:
        </label>

        <select
          id="estado-demo"
          class="rounded-lg border border-slate-300 bg-white
                 px-3 py-2 text-sm dark:border-slate-700
                 dark:bg-slate-900"
        >
          <option value="real">Datos reales</option>
          <option value="ideal">Ideal (demostración)</option>
          <option value="empty">Vacío (demostración)</option>
          <option value="loading">Cargando (demostración)</option>
          <option value="partial">Parcial (demostración)</option>
          <option value="error">Error (demostración)</option>
        </select>
      </div>

      <p
        id="aviso-demo"
        role="status"
        aria-live="polite"
        class="mt-2 text-xs text-slate-500 dark:text-slate-400"
      >
        Se muestran los datos disponibles del sistema.
      </p>
    </section>

    <!-- CONTENIDO INFERIOR -->
    <div class="mt-5 grid gap-4 xl:grid-cols-[1.6fr_1fr]">

      <!-- PRÓXIMOS TURNOS -->
      <section class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <div class="mb-4 flex items-center justify-between gap-2">
          <h2 class="text-base font-bold">Próximos turnos</h2>
          <a
            href="/calendario"
            class="text-sm font-medium text-emerald-700
                   hover:underline dark:text-emerald-400"
          >
            Ver calendario →
          </a>
        </div>

        <div id="lista-turnos" aria-live="polite">
          <p class="text-sm text-slate-500">Cargando información...</p>
        </div>
      </section>

      <!-- TAREAS PRIORITARIAS -->
      <section class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="mb-4 text-base font-bold">Tareas prioritarias</h2>

        <div id="lista-tareas" aria-live="polite">
          <p class="text-sm text-slate-500">Cargando información...</p>
        </div>
      </section>
    </div>

  </AppShell>
</Layout>

<script>
  type Resumen = {
    turnos: number;
    cupos: number;
    personas: number;
    asistencias: number;
  };

  const resumenVacio: Resumen = {
    turnos: 0,
    cupos: 0,
    personas: 0,
    asistencias: 0
  };

  // Datos ilustrativos basados en la pantalla de Figma.
  // NO son registros de MySQL.
  const resumenFigma: Resumen = {
    turnos: 4,
    cupos: 7,
    personas: 32,
    asistencias: 1
  };

  const indicadores = [
    'total-turnos',
    'total-cupos',
    'total-personas',
    'total-asistencias'
  ];

  const listaTurnos = document.querySelector<HTMLElement>('#lista-turnos');
  const listaTareas = document.querySelector<HTMLElement>('#lista-tareas');
  const aviso = document.querySelector<HTMLElement>('#aviso-demo');
  const selector = document.querySelector<HTMLSelectElement>('#estado-demo');

  function mostrarResumen(datos: Resumen | null) {
    const valores = datos
      ? [datos.turnos, datos.cupos, datos.personas, datos.asistencias]
      : ['—', '—', '—', '—'];

    indicadores.forEach((id, indice) => {
      const elemento = document.getElementById(id);
      if (elemento) elemento.textContent = String(valores[indice]);
    });
  }

  function mostrarVacio() {
    mostrarResumen(resumenVacio);

    if (listaTurnos) {
      listaTurnos.innerHTML = `
        <div class="rounded-lg bg-slate-50 p-6 text-center
                    dark:bg-slate-800">
          <p class="font-semibold">No hay turnos próximos</p>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            Crea tu primer turno para comenzar a organizar actividades.
          </p>
          <a href="/crear-turno"
             class="mt-4 inline-block rounded-lg bg-emerald-700
                    px-4 py-2 text-sm font-medium text-white">
            + Crear turno
          </a>
        </div>
      `;
    }

    if (listaTareas) {
      listaTareas.innerHTML = `
        <p class="rounded-lg bg-slate-50 p-5 text-sm
                  text-slate-600 dark:bg-slate-800
                  dark:text-slate-300">
          No hay tareas prioritarias registradas.
        </p>
      `;
    }
  }

  function mostrarIdeal() {
    mostrarResumen(resumenFigma);

    if (listaTurnos) {
      listaTurnos.innerHTML = `
        <div class="space-y-3">
          ${[
            ['Reforestación · Cerro Azul', 'Necesita personal', '20 cupos · 7 pendientes'],
            ['Rescate de fauna', 'Confirmado', '8 cupos completos'],
            ['Limpieza comunitaria', 'Necesita personal', '12 cupos · 2 pendientes']
          ].map(([nombre, estado, detalle]) => `
            <div class="rounded-lg bg-slate-50 p-4 dark:bg-slate-800">
              <p class="text-sm font-semibold">${nombre}</p>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                ${detalle}
              </p>
              <span class="mt-2 inline-block rounded-md px-2 py-1 text-xs
                ${estado === 'Confirmado'
                  ? 'bg-emerald-100 text-emerald-800'
                  : 'bg-amber-100 text-amber-900'}">
                ${estado}
              </span>
            </div>
          `).join('')}
        </div>
      `;
    }

    if (listaTareas) {
      listaTareas.innerHTML = `
        <ul class="space-y-3 text-sm">
          <li class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800">
            ✓ Cubrir 7 cupos pendientes
          </li>
          <li class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800">
            ✓ Revisar asistencia
          </li>
          <li class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800">
            ✓ Confirmar responsables
          </li>
        </ul>
      `;
    }
  }

  function cambiarEstado(estado: string) {
    if (aviso) {
      aviso.textContent = estado === 'real'
        ? 'Consultando datos reales de VolunTurno.'
        : 'Modo demostración: los datos de esta vista son simulados y no modifican MySQL.';
    }

    if (estado === 'ideal') {
      mostrarIdeal();
      return;
    }

    if (estado === 'empty') {
      mostrarVacio();
      return;
    }

    if (estado === 'loading') {
      mostrarResumen(null);
      if (listaTurnos) listaTurnos.textContent = 'Cargando turnos...';
      if (listaTareas) listaTareas.textContent = 'Cargando tareas...';
      return;
    }

    if (estado === 'partial') {
      mostrarResumen({ ...resumenFigma, asistencias: 0 });
      if (listaTurnos) {
        listaTurnos.textContent =
          'Información parcial: algunos turnos aún requieren asignaciones.';
      }
      if (listaTareas) {
        listaTareas.textContent =
          'Hay tareas pendientes de completar.';
      }
      return;
    }

    if (estado === 'error') {
      mostrarResumen(null);
      if (listaTurnos) {
        listaTurnos.textContent =
          'No se pudo cargar la información de turnos.';
      }
      if (listaTareas) {
        listaTareas.textContent =
          'Error al consultar las tareas.';
      }
      return;
    }

    // El endpoint actual solo entrega usuarios y turnos totales.
    // No debemos inventar los otros indicadores.
    cargarDatosReales();
  }

  async function cargarDatosReales() {
    mostrarResumen(null);

    try {
      const respuesta = await fetch(
        'http://localhost:3006/api/volunturno/estado'
      );

      if (!respuesta.ok) throw new Error('Error de conexión');

      const datos = await respuesta.json();

      // Solo mostramos datos que la API realmente proporciona.
      const turnos = document.getElementById('total-turnos');
      const personas = document.getElementById('total-personas');

      if (turnos) turnos.textContent = String(datos.turnosRegistrados);
      if (personas) personas.textContent = String(datos.usuariosRegistrados);

      if (listaTurnos) {
        listaTurnos.textContent = datos.turnosRegistrados === 0
          ? 'Todavía no se han registrado turnos. Puedes crear el primero.'
          : 'Hay turnos registrados. El listado detallado se conectará con el módulo Calendario.';
      }

      if (listaTareas) {
        listaTareas.textContent =
          'Las tareas prioritarias se mostrarán cuando conectemos las asignaciones y asistencias.';
      }

      if (aviso) {
        aviso.textContent =
          'Datos reales: usuarios y turnos registrados. Los demás indicadores requieren consultas adicionales.';
      }

    } catch {
      if (listaTurnos) listaTurnos.textContent = 'No se pudo conectar al backend.';
      if (listaTareas) listaTareas.textContent = 'Comprueba que Express esté funcionando.';
      if (aviso) aviso.textContent = 'Error al consultar los datos reales.';
    }
  }

  selector?.addEventListener('change', () => {
    cambiarEstado(selector.value);
  });

  // Cargar únicamente después de validar la sesión.
  document.addEventListener('volunturno:autorizado', () => {
    cambiarEstado(selector?.value ?? 'real');
  }, { once: true });
</script>
