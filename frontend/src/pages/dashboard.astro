
---
import Layout from '../layouts/Layout.astro';
import AppShell from '../components/AppShell.astro';
---

<Layout>
  <AppShell
    titulo="Panel principal"
    descripcion="Resumen de actividad y tareas prioritarias."
    pagina="dashboard"
  >

    <!-- INDICADORES PRINCIPALES -->
    <section
      aria-label="Indicadores generales" data-i18n-aria-label="dashboard.generalIndicators"
      class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"
    >
      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          <span data-i18n="dashboard.upcomingCount">Turnos próximos</span>
        </h2>
        <p id="total-turnos" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-emerald-700 dark:text-emerald-400">
          <span data-i18n="dashboard.upcomingActivities">Próximas actividades</span>
        </p>
      </article>

      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          <span data-i18n="dashboard.vacancies">Cupos por cubrir</span>
        </h2>
        <p id="total-cupos" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-amber-700 dark:text-amber-400">
          <span data-i18n="dashboard.pendingAssignment">Pendientes de asignación</span>
        </p>
      </article>

      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          <span data-i18n="dashboard.activePeople">Personas activas</span>
        </h2>
        <p id="total-personas" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-emerald-700 dark:text-emerald-400">
          <span data-i18n="dashboard.registeredTeam">Equipo registrado</span>
        </p>
      </article>

      <article class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="text-sm text-slate-600 dark:text-slate-400">
          <span data-i18n="dashboard.pendingAttendance">Asistencias pendientes</span>
        </h2>
        <p id="total-asistencias" class="mt-2 text-3xl font-bold">—</p>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          <span data-i18n="dashboard.toVerify">Por verificar</span>
        </p>
      </article>
    </section>

    <!-- ESTADOS DE INTERFAZ -->
    <section class="mt-5" aria-label="Estados de interfaz" data-i18n-aria-label="dashboard.statesLabel">
      <div class="flex flex-wrap items-center gap-3">
        <label for="estado-demo" class="text-sm font-medium">
          <span data-i18n="dashboard.statesView">Vista de estados:</span>
        </label>

        <select
          id="estado-demo"
          class="rounded-lg border border-slate-300 bg-white
                 px-3 py-2 text-sm dark:border-slate-700
                 dark:bg-slate-900"
        >
          <option value="real" data-i18n="dashboard.real">Datos reales</option>
          <option value="ideal" data-i18n="dashboard.ideal">Ideal (demostración)</option>
          <option value="empty" data-i18n="dashboard.empty">Vacío (demostración)</option>
          <option value="loading" data-i18n="dashboard.loading">Cargando (demostración)</option>
          <option value="partial" data-i18n="dashboard.partial">Parcial (demostración)</option>
          <option value="error" data-i18n="dashboard.error">Error (demostración)</option>
        </select>
      </div>

      <p
        id="aviso-demo"
        role="status"
        aria-live="polite"
        class="mt-2 text-xs text-slate-500 dark:text-slate-400"
      >
        <span data-i18n="dashboard.availableData">Se muestran los datos disponibles del sistema.</span>
      </p>
    </section>


    <!-- FORMATOS REGIONALES: valores ilustrativos y no datos financieros reales -->
    <section aria-labelledby="formato-local-titulo" class="mt-4 rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
      <h2 id="formato-local-titulo" class="mb-3 text-sm font-bold" data-i18n="dashboard.localeExample">Ejemplo de formatos regionales</h2>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="min-w-0 rounded-lg bg-slate-50 p-3 dark:bg-slate-800">
          <p class="text-xs text-slate-600 dark:text-slate-400" data-i18n="dashboard.date">Fecha</p>
          <p id="formato-fecha" class="break-words text-sm font-semibold">16/11/2026</p>
        </div>
        <div class="min-w-0 rounded-lg bg-slate-50 p-3 dark:bg-slate-800">
          <p class="text-xs text-slate-600 dark:text-slate-400" data-i18n="dashboard.time">Hora</p>
          <p id="formato-hora" class="break-words text-sm font-semibold">14:30</p>
        </div>
        <div class="min-w-0 rounded-lg bg-slate-50 p-3 dark:bg-slate-800">
          <p class="text-xs text-slate-600 dark:text-slate-400" data-i18n="dashboard.currency">Moneda</p>
          <p id="formato-moneda" class="break-words text-sm font-semibold">S/ 1,250.50</p>
        </div>
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400" data-i18n="dashboard.localeDisclaimer">Valores demostrativos; no representan pagos reales.</p>
    </section>

    <!-- CONTENIDO INFERIOR -->
    <div class="mt-5 grid gap-4 xl:grid-cols-[1.6fr_1fr]">

      <!-- PRÓXIMOS TURNOS -->
      <section class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <div class="mb-4 flex items-center justify-between gap-2">
          <h2 class="text-base font-bold"><span data-i18n="dashboard.upcoming">Próximos turnos</span></h2>
          <a
            href="/calendario"
            class="text-sm font-medium text-emerald-700
                   hover:underline dark:text-emerald-400"
          >
            <span data-i18n="dashboard.viewCalendar">Ver calendario →</span>
          </a>
        </div>

        <div id="lista-turnos" aria-live="polite">
          <p class="text-sm text-slate-500"><span data-i18n="dashboard.loadingInfo">Cargando información...</span></p>
        </div>
      </section>

      <!-- TAREAS PRIORITARIAS -->
      <section class="rounded-xl bg-white p-5 shadow-sm dark:bg-slate-900">
        <h2 class="mb-4 text-base font-bold"><span data-i18n="dashboard.priorityTasks">Tareas prioritarias</span></h2>

        <div id="lista-tareas" aria-live="polite">
          <p class="text-sm text-slate-500"><span data-i18n="dashboard.loadingInfo">Cargando información...</span></p>
        </div>
      </section>
    </div>

  </AppShell>
</Layout>

<script>
  import { traducir as t, formatoFecha, formatoHora, formatoMoneda } from '../utils/i18n';

  type Resumen = { turnos: number; cupos: number; personas: number; asistencias: number };
  const vacio: Resumen = { turnos: 0, cupos: 0, personas: 0, asistencias: 0 };
  // Muestra Figma (valores de ejemplo, no extraídos de MySQL).
  const ejemplo: Resumen = { turnos: 4, cupos: 7, personas: 32, asistencias: 1 };
  const indicadores = ['total-turnos', 'total-cupos', 'total-personas', 'total-asistencias'];
  const turnos = document.querySelector<HTMLElement>('#lista-turnos');
  const tareas = document.querySelector<HTMLElement>('#lista-tareas');
  const aviso = document.querySelector<HTMLElement>('#aviso-demo');
  const selector = document.querySelector<HTMLSelectElement>('#estado-demo');
  let autenticado = false;

  function resumen(datos: Resumen | null) {
    const valores = datos ? [datos.turnos, datos.cupos, datos.personas, datos.asistencias] : ['—', '—', '—', '—'];
    indicadores.forEach((id, i) => {
      const campo = document.getElementById(id);
      if (campo) campo.textContent = String(valores[i]);
    });
  }

  function mostrarVacio() {
    resumen(vacio);
    if (turnos) turnos.innerHTML = `
      <div class="rounded-lg bg-slate-50 p-6 text-center dark:bg-slate-800">
        <p class="font-semibold">${t('dashboard.emptyUpcoming')}</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">${t('dashboard.createFirst')}</p>
        <a href="/crear-turno" class="mt-4 inline-block max-w-full rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white break-words">${t('dashboard.createShift')}</a>
      </div>`;
    if (tareas) tareas.innerHTML = `<p class="rounded-lg bg-slate-50 p-5 text-sm text-slate-600 dark:bg-slate-800 dark:text-slate-300">${t('dashboard.emptyTasks')}</p>`;
  }

  function mostrarIdeal() {
    resumen(ejemplo);
    const muestras: Array<[string, string, string]> = [
      ['dashboard.sample1', 'dashboard.needStaff', 'dashboard.slotsPending'],
      ['dashboard.sample2', 'dashboard.confirmed', 'dashboard.slotsFull'],
      ['dashboard.sample3', 'dashboard.needStaff', 'dashboard.slotsTwo']
    ];
    if (turnos) turnos.innerHTML = `<div class="space-y-3">${muestras.map(([titulo,estado,detalle]) => `
      <div class="rounded-lg bg-slate-50 p-4 dark:bg-slate-800">
        <p class="break-words text-sm font-semibold">${t(titulo)}</p>
        <p class="mt-1 break-words text-xs text-slate-500 dark:text-slate-400">${t(detalle)}</p>
        <span class="mt-2 inline-block max-w-full break-words rounded-md px-2 py-1 text-xs ${estado === 'dashboard.confirmed' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900'}">${t(estado)}</span>
      </div>`).join('')}</div>`;
    if (tareas) tareas.innerHTML = `<ul class="space-y-3 text-sm">${['dashboard.taskCover','dashboard.taskAttendance','dashboard.taskResponsible']
      .map(clave => `<li class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800">${t(clave)}</li>`).join('')}</ul>`;
  }

  async function cargarReales() {
    resumen(null);
    try {
      const r = await fetch('http://localhost:3006/api/volunturno/estado');
      if (!r.ok) throw new Error('Error de conexión');
      const datos = await r.json();
      document.getElementById('total-turnos')!.textContent = String(datos.turnosRegistrados);
      document.getElementById('total-personas')!.textContent = String(datos.usuariosRegistrados);
      if (turnos) turnos.textContent = t(datos.turnosRegistrados === 0 ? 'dashboard.noShiftsYet' : 'dashboard.hasShifts');
      if (tareas) tareas.textContent = t('dashboard.tasksLater');
      if (aviso) aviso.textContent = t('dashboard.realDataInfo');
    } catch {
      if (turnos) turnos.textContent = t('dashboard.backendUnavailable');
      if (tareas) tareas.textContent = t('dashboard.expressCheck');
      if (aviso) aviso.textContent = t('dashboard.realFetchError');
    }
  }

  function cambiarEstado(estado: string) {
    if (aviso) aviso.textContent = t(estado === 'real' ? 'dashboard.fetchingReal' : 'dashboard.demoNotice');
    if (estado === 'ideal') return mostrarIdeal();
    if (estado === 'empty') return mostrarVacio();
    if (estado === 'loading') {
      resumen(null);
      if (turnos) turnos.textContent = t('dashboard.loadingShifts');
      if (tareas) tareas.textContent = t('dashboard.loadingTasks');
      return;
    }
    if (estado === 'partial') {
      resumen({ ...ejemplo, asistencias: 0 });
      if (turnos) turnos.textContent = t('dashboard.partialShifts');
      if (tareas) tareas.textContent = t('dashboard.partialTasks');
      return;
    }
    if (estado === 'error') {
      resumen(null);
      if (turnos) turnos.textContent = t('dashboard.errorShifts');
      if (tareas) tareas.textContent = t('dashboard.errorTasks');
      return;
    }
    void cargarReales();
  }

  function formatosRegionales() {
    const ejemplo = new Date(2026, 10, 16, 14, 30); // Fecha fija de muestra.
    const fecha = document.querySelector<HTMLElement>('#formato-fecha');
    const hora = document.querySelector<HTMLElement>('#formato-hora');
    const moneda = document.querySelector<HTMLElement>('#formato-moneda');
    if (fecha) fecha.textContent = formatoFecha(ejemplo);
    if (hora) hora.textContent = formatoHora(ejemplo);
    if (moneda) moneda.textContent = formatoMoneda(1250.50);
  }

  formatosRegionales();
  selector?.addEventListener('change', () => cambiarEstado(selector.value));
  document.addEventListener('volunturno:idioma', () => {
    formatosRegionales();
    if (autenticado) cambiarEstado(selector?.value ?? 'real');
  });
  document.addEventListener('volunturno:autorizado', () => {
    autenticado = true;
    cambiarEstado(selector?.value ?? 'real');
  }, { once: true });
</script>
