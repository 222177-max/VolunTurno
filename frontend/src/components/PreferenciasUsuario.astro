<!-- Menú de preferencias integrado en el avatar del coordinador. -->
<div class="relative" data-preferencias>
  <button
    id="preferencias-abrir"
    type="button"
    aria-controls="preferencias-panel"
    aria-expanded="false"
    aria-label="Abrir preferencias"
    data-i18n-aria-label="preferences.settings"
    class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-900 text-sm font-bold text-white ring-offset-2 transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-emerald-500 dark:ring-offset-slate-900"
  >
    <span id="inicial-usuario" aria-hidden="true">U</span>
    <span class="sr-only" data-i18n="preferences.settings">Abrir preferencias</span>
  </button>
  <section
    id="preferencias-panel"
    hidden
    aria-labelledby="preferencias-titulo"
    class="absolute right-0 top-[calc(100%+10px)] z-[80] w-[min(300px,calc(100vw-32px))] rounded-xl border border-slate-200 bg-white p-4 text-slate-900 shadow-xl dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 id="preferencias-titulo" class="font-bold" data-i18n="preferences.title">Preferencias</h2>
      <button type="button" id="preferencias-cerrar" class="rounded-md px-2 py-1 text-sm hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-emerald-600 dark:hover:bg-slate-700" aria-label="Cerrar preferencias" data-i18n-aria-label="preferences.close">✕</button>
    </div>
    <div class="space-y-4">
      <div class="space-y-1">
        <p class="text-sm font-semibold" data-i18n="preferences.theme">Apariencia</p>
        <!-- Conserva id=cambiar-tema para el asistente global de voz. -->
        <button
          id="cambiar-tema"
          type="button"
          aria-pressed="false"
          class="flex min-h-11 w-full items-center justify-between rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-emerald-600 dark:border-slate-600 dark:hover:bg-slate-800"
        >
          <span id="texto-tema">Modo oscuro</span>
          <span id="icono-tema" aria-hidden="true">☾</span>
        </button>
      </div>
      <div class="space-y-1">
        <label for="seleccionar-idioma" class="block text-sm font-semibold" data-i18n="preferences.language">Idioma de la interfaz</label>
        <select
          id="seleccionar-idioma"
          class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-emerald-600 dark:border-slate-600 dark:bg-slate-800 dark:text-white"
        >
          <option value="es">Español (Perú)</option>
          <option value="en">English (US)</option>
          <option value="qu">Quechua Chanka (Apurímac)</option>
        </select>
      </div>
    </div>
  </section>
</div>

<script>
  import { aplicarTraducciones, establecerIdioma, idiomaActual, traducir } from '../utils/i18n';

  const abrir = document.querySelector<HTMLButtonElement>('#preferencias-abrir');
  const panel = document.querySelector<HTMLElement>('#preferencias-panel');
  const cerrar = document.querySelector<HTMLButtonElement>('#preferencias-cerrar');
  const idioma = document.querySelector<HTMLSelectElement>('#seleccionar-idioma');
  const botonTema = document.querySelector<HTMLButtonElement>('#cambiar-tema');
  const iconoTema = document.querySelector<HTMLElement>('#icono-tema');
  const textoTema = document.querySelector<HTMLElement>('#texto-tema');

  function abrirMenu(visible: boolean) {
    if (!panel || !abrir) return;
    panel.hidden = !visible;
    abrir.setAttribute('aria-expanded', String(visible));
    if (visible) idioma?.focus();
  }
  abrir?.addEventListener('click', () => abrirMenu(Boolean(panel?.hidden)));
  cerrar?.addEventListener('click', () => { abrirMenu(false); abrir?.focus(); });
  document.addEventListener('pointerdown', evento => {
    if (!(evento.target instanceof Node)) return;
    if (!document.querySelector('[data-preferencias]')?.contains(evento.target)) abrirMenu(false);
  });
  document.addEventListener('keydown', evento => {
    if (evento.key === 'Escape' && panel && !panel.hidden) {
      abrirMenu(false); abrir?.focus();
    }
  });

  function aplicarTema(oscuro: boolean) {
    document.documentElement.classList.toggle('dark', oscuro);
    localStorage.setItem('volunturno-tema', oscuro ? 'dark' : 'light');
    botonTema?.setAttribute('aria-pressed', String(oscuro));
    if (iconoTema) iconoTema.textContent = oscuro ? '☀' : '☾';
    if (textoTema) textoTema.textContent = traducir(oscuro ? 'preferences.light' : 'preferences.dark');
  }
  const preferencia = localStorage.getItem('volunturno-tema');
  aplicarTema(preferencia === 'dark' || (preferencia === null && window.matchMedia('(prefers-color-scheme: dark)').matches));
  botonTema?.addEventListener('click', () => aplicarTema(!document.documentElement.classList.contains('dark')));

  if (idioma) idioma.value = idiomaActual();
  aplicarTraducciones();
  idioma?.addEventListener('change', () => {
    establecerIdioma(idioma.value === 'en' ? 'en' : idioma.value === 'qu' ? 'qu' : 'es');
    aplicarTema(document.documentElement.classList.contains('dark'));
  });
</script>
